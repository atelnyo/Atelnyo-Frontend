# ───────────────────────────────────────────────────────────────────────
# Atelnyo Frontend — Git Ignore
# ───────────────────────────────────────────────────────────────────────

# ===== Environment files — NEVER commit real credentials =====
# .env.example is the only env file tracked in git (placeholders only).
.env
.env.*
!.env.example

# ===== Node / Vite =====
node_modules/
dist/
dist-ssr/
.vite/
.cache/
*.local
*.tsbuildinfo

# ===== Build outputs =====
build/
out/

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Test artifacts (regenerated on every run) =====
test-results/
playwright-report/
.playwright/
coverage/
.coverage
htmlcov/

# ===== Editors / IDEs =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Misc =====
*.tgz
.tmp/
.temp/
downloads/

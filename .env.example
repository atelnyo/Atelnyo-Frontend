# ───────────────────────────────────────────────────────────────────────
# Atelnyo Frontend — environment variable template
# ───────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you need:
#
#   cp .env.example .env
#
# NEVER commit your real `.env`. All values below are placeholders.
#
# ─────── How Vite env vars work ────────────────────────────────────────
# Anything prefixed `VITE_` is BAKED INTO the client bundle at
# `npm run build` time — never put a secret in a VITE_ variable.
# ───────────────────────────────────────────────────────────────────────

# ─────── API ───────────────────────────────────────────────────────────

# Base URL of the Atelnyo API the SPA talks to. In local development the
# default is `/api/`, which the Vite dev server proxies to a backend on
# http://127.0.0.1:8000 (see `server.proxy` in vite.config.js).
#
# VITE_API_BASE_URL=/api/

# WebSocket base URL for realtime features (defaults derive from the API URL).
#
# VITE_WS_BASE_URL=ws://127.0.0.1:8000

# ─────── Authentication (all values below are PUBLIC client-side) ─────

# Google Identity Services client ID (Web application type). Public by
# design; the backend independently verifies the ID token. Leave unset
# to hide the "Continue with Google" button.
#
# VITE_GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Optional Supabase auth path. Leave unset to use Django-only auth.
#
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Stripe browser-side publishable key (pk_test_… / pk_live_…). Safe for
# client bundles; the backend holds its own secret key.
#
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ─────── Firebase (Web Push / Cloud Messaging — public web config) ────

# These Firebase web-app values are public client-side configuration.
# Get them from Firebase Console → Project Settings → General.
# Without them, push notifications are disabled in the browser.
#
# VITE_FIREBASE_API_KEY=AIzaSyPlaceHolder
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder
# VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_FIREBASE_VAPID_KEY=your-public-vapid-key

# ─────── Misc ──────────────────────────────────────────────────────────

# Set to 1 to re-enable the native PWA "Install Atelnyo" prompt
# (hidden by default; the "new version available" banner always stays on).
#
# VITE_INSTALL_PROMPT_ENABLED=1
